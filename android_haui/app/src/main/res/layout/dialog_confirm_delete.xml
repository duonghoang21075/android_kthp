<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_detail_card"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Tiêu đề hộp thoại -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/delete_confirm_title"
        android:textColor="@color/text_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Thẻ tóm tắt phòng đang xóa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_hero_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvDeleteRoomCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/card_blue_bg"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="LAB201" />

        <TextView
            android:id="@+id/tvDeleteRoomName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Phòng Thực hành Máy tính 1" />
    </LinearLayout>

    <!-- Nội dung cảnh báo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="4dp"
        android:text="@string/delete_confirm_desc"
        android:textColor="@color/text_gray_dark"
        android:textSize="14sp" />

    <!-- Các nút hành động: Hủy & Xác nhận xóa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelDelete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_filter_inactive"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConfirmDelete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_danger_solid_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_confirm_delete"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
