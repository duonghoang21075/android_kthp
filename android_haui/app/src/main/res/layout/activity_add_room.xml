<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    tools:context=".ui.AddRoomActivity">

    <!-- Header tách riêng tái sử dụng -->
    <include
        android:id="@+id/headerLayout"
        layout="@layout/layout_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomActionLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">



            <!-- Form Container Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_detail_card"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Trường Mã phòng * -->
                <TextView
                    style="@style/FormLabel"
                    android:text="@string/add_room_code_label" />

                <EditText
                    android:id="@+id/etRoomCode"
                    style="@style/FormEditText"
                    android:hint="@string/add_room_code_hint"
                    android:inputType="textCapCharacters"
                    android:singleLine="true"
                    android:importantForAutofill="no" />

                <TextView
                    android:id="@+id/tvRoomCodeHelper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/add_room_code_helper"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <!-- Trường Tên phòng * -->
                <TextView
                    style="@style/FormLabel"
                    android:text="@string/add_room_name_label" />

                <EditText
                    android:id="@+id/etRoomName"
                    style="@style/FormEditText"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/add_room_name_hint"
                    android:inputType="textCapWords"
                    android:singleLine="true"
                    android:importantForAutofill="no" />

                <!-- Tầng và loại phòng (2 Columns) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Cột Tầng * -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FormLabel"
                            android:text="@string/add_room_floor_label" />

                        <LinearLayout
                            android:id="@+id/btnSelectFloor"
                            style="@style/FormInputContainer"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvSelectedFloor"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/add_room_floor_val"
                                android:textColor="@color/text_dark"
                                android:textSize="15sp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_down"
                                app:tint="@color/text_gray"
                                android:contentDescription="@null" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Cột Loại phòng * -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FormLabel"
                            android:text="@string/add_room_type_label" />

                        <LinearLayout
                            android:id="@+id/btnSelectType"
                            style="@style/FormInputContainer"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvSelectedType"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/add_room_type_val"
                                android:textColor="@color/text_dark"
                                android:textSize="15sp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_down"
                                app:tint="@color/text_gray"
                                android:contentDescription="@null" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Sức chứa và trạng thái (2 Columns) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Cột Sức chứa * -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FormLabel"
                            android:text="@string/add_room_capacity_label" />

                        <EditText
                            android:id="@+id/etCapacity"
                            style="@style/FormEditText"
                            android:hint="@string/add_room_capacity_hint"
                            android:text="@string/add_room_capacity_default"
                            android:inputType="number"
                            android:singleLine="true"
                            android:importantForAutofill="no" />
                    </LinearLayout>

                    <!-- Cột Trạng thái ban đầu -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FormLabel"
                            android:text="@string/add_room_status_label" />

                        <LinearLayout
                            android:id="@+id/btnSelectStatus"
                            style="@style/FormInputContainer"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true">

                            <FrameLayout
                                android:id="@+id/badgeInitialStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_empty"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp">

                                <TextView
                                    android:id="@+id/tvInitialStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/status_empty"
                                    android:textColor="@color/status_empty_text"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_down"
                                app:tint="@color/text_gray"
                                android:contentDescription="@null" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Trường Thiết bị -->
                <TextView
                    style="@style/FormLabel"
                    android:text="@string/add_room_equipment_label" />

                <EditText
                    android:id="@+id/etEquipment"
                    style="@style/FormEditText"
                    android:hint="@string/add_room_equipment_hint"
                    android:text="@string/add_room_equipment_default"
                    android:inputType="text"
                    android:singleLine="true"
                    android:importantForAutofill="no" />

                <!-- Gợi ý thiết bị nhanh -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipEquipTheory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_suggestion_chip"
                            android:text="@string/add_room_equipment_suggest_1"
                            android:textColor="@color/card_blue_bg"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipEquipLab"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_suggestion_chip"
                            android:text="@string/add_room_equipment_suggest_2"
                            android:textColor="@color/card_blue_bg"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipEquipHall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_suggestion_chip"
                            android:text="@string/add_room_equipment_suggest_3"
                            android:textColor="@color/card_blue_bg"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Trường Ghi chú -->
                <TextView
                    style="@style/FormLabel"
                    android:text="@string/add_room_note_label" />

                <EditText
                    android:id="@+id/etNote"
                    style="@style/FormEditText"
                    android:hint="@string/add_room_note_hint"
                    android:text="@string/add_room_note_default"
                    android:inputType="text"
                    android:singleLine="true"
                    android:importantForAutofill="no" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Top Divider for Bottom Action -->
    <View
        android:id="@+id/bottomDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_gray"
        app:layout_constraintBottom_toTopOf="@id/bottomActionLayout" />

    <!-- Fixed Bottom Actions -->
    <LinearLayout
        android:id="@+id/bottomActionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="96dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_secondary_button"
            android:gravity="center"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_filter_inactive"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="@string/btn_save_room"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
