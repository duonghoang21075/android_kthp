<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_room_item"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvItemRoomCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/badgeStatus"
            android:layout_marginEnd="8dp"
            android:layout_centerVertical="true"
            tools:text="1501" />

        <FrameLayout
            android:id="@+id/badgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_maint"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/tvItemStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/status_maint_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Bảo trì" />
        </FrameLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/tvItemRoomName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_gray_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        tools:text="Phòng máy 1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvItemFloorAndType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            tools:text="Tầng 15 · Phòng thực hành" />

        <TextView
            android:id="@+id/tvItemCapacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            tools:text=" · 35 chỗ" />
    </LinearLayout>
</LinearLayout>