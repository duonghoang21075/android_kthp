<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/white"
    android:paddingVertical="10dp"
    android:paddingHorizontal="8dp"
    android:baselineAligned="false">

    <!-- Tab 0: Tổng quan -->
    <LinearLayout
        android:id="@+id/navTabOverview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/navIndicatorOverview"
            android:layout_width="58dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_nav_active">
            <ImageView
                android:id="@+id/navIconOverview"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                app:tint="@color/card_blue_bg"
                android:layout_gravity="center"
                android:contentDescription="@string/tab_overview"/>
        </FrameLayout>

        <TextView
            android:id="@+id/navTextOverview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_overview"
            android:textColor="@color/card_blue_bg"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Tab 1: Phòng học -->
    <LinearLayout
        android:id="@+id/navTabRooms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/navIndicatorRooms"
            android:layout_width="58dp"
            android:layout_height="30dp">
            <ImageView
                android:id="@+id/navIconRooms"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_room"
                app:tint="@color/text_gray"
                android:layout_gravity="center"
                android:contentDescription="@string/tab_rooms"/>
        </FrameLayout>

        <TextView
            android:id="@+id/navTextRooms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_rooms"
            android:textColor="@color/text_gray"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Tab 2: Thống kê -->
    <LinearLayout
        android:id="@+id/navTabStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/navIndicatorStats"
            android:layout_width="58dp"
            android:layout_height="30dp">
            <ImageView
                android:id="@+id/navIconStats"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chart"
                app:tint="@color/text_gray"
                android:layout_gravity="center"
                android:contentDescription="@string/tab_stats"/>
        </FrameLayout>

        <TextView
            android:id="@+id/navTextStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_stats"
            android:textColor="@color/text_gray"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Tab 3: Quản lý -->
    <LinearLayout
        android:id="@+id/navTabManage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/navIndicatorManage"
            android:layout_width="58dp"
            android:layout_height="30dp">
            <ImageView
                android:id="@+id/navIconManage"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_person"
                app:tint="@color/text_gray"
                android:layout_gravity="center"
                android:contentDescription="@string/tab_manage"/>
        </FrameLayout>

        <TextView
            android:id="@+id/navTextManage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_manage"
            android:textColor="@color/text_gray"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
</LinearLayout>